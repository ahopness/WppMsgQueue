{
  "manifest_version": 3,
  "name": "Fila de Mensagens WhatsApp",
  "version": "0.1.2",
  "description": "Prepara conversas com números não salvos para envio manual.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Abrir fila de mensagens",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "panel.html"
  }
}
